*.swp
# No trailing slash: `venv/` matches only real directories, and a venv or
# node_modules symlinked into a git worktree (workmux files.symlink) would
# otherwise show as untracked and block `workmux remove`/`merge`.
.venv
venv
node_modules
.envrc
.testmondata
coverage.xml
junit/
.coverage
htmlcov/
.aws-sam/
__pycache__/
.aider*

# Per-machine identity and secrets
.gitconfig.local
.gitconfig.work
.bashrc.local
.zshrc.local

# Claude Code: ignore everything in .claude/ except skills/, commands/ and
# agents/. The /* form is required: a bare `.claude/` would ignore the
# directory itself and git cannot re-include anything inside an ignored dir.
# This file doubles as the global core.excludesfile (~/.gitignore symlinks here).
**/.claude/*
!**/.claude/skills/
!**/.claude/commands/
!**/.claude/agents/

# Pi handoff briefs (prompts/handoff.md) and per-worktree task state
# (extensions/task-state.ts). Anchored: only the repo-root TASK.md.
handoff-*.md
/TASK.md

# Pi project-local permission rules
**/.pi/extensions/pi-permission-system/config.json

# Installed by workmux (`workmux setup`), not hand-maintained
pi/agent/extensions/workmux-status.ts
pi/agent/skills/coordinator/
pi/agent/skills/merge/
pi/agent/skills/open-pr/
pi/agent/skills/rebase/
pi/agent/skills/workmux/
pi/agent/skills/worktree/
