# Pi local state (should stay in ~/.pi/agent, not in this repo)
# This repo only tracks versioned config/customizations in pi/agent/

# If you later add package scaffolding under pi/agent, keep deps out of git
pi/agent/**/node_modules/
pi/agent/**/.cache/
pi/agent/**/dist/
pi/agent/**/.turbo/
pi/agent/**/.parcel-cache/
pi/agent/**/.DS_Store

# If you ever accidentally copy these into the repo, ignore them
pi/agent/sessions/
pi/agent/npm/
pi/agent/git/
pi/agent/bin/
pi/agent/auth.json
