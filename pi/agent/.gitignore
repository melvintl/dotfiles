# Local Pi secrets and generated state; do not commit.
auth.json
trust.json
sessions/
npm/
git/
models-store.json
*.log
pi-tui-crash.log
extensions/**/logs/
verify/reports/

# Machine-local integrations: a symlink into the mise hunk install, and a
# file herdr installs and overwrites itself.
skills/hunk-review
extensions/herdr-agent-state.ts

# Machine-local extension config (client-specific values); tracked extensions
# read these and no-op when absent. Examples ship as *.local.json.example.
extensions/**/*.local.json

# Build/dependency output from skills and extensions.
**/node_modules/
**/dist/
**/.cache/
**/.turbo/
**/.parcel-cache/
.DS_Store
