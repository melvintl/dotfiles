[core]
    editor = nvim
	excludesfile = ~/.gitignore
    # Side-by-side lives here, not in [delta], so lazygit can reuse [delta] without it
    pager = delta --side-by-side --line-numbers

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    syntax-theme = OneHalfDark
    # OneDark: muted line backgrounds, quiet grey chrome so the code stands out.
    # lazygit's pagers read these too (.config/lazygit/config.yml)
    plus-style = syntax "#2f3b2c"
    minus-style = syntax "#3f2d31"
    plus-emph-style = syntax "#405a35"
    minus-emph-style = syntax "#6a3a40"
    file-style = "#61afef" bold
    file-decoration-style = "#3e4451" ol
    hunk-header-style = "#5c6370" italic
    hunk-header-decoration-style = none
    line-numbers-minus-style = "#e06c75"
    line-numbers-plus-style = "#98c379"
    line-numbers-zero-style = "#4b5263"
    line-numbers-left-style = "#3e4451"
    line-numbers-right-style = "#3e4451"

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    tool = difftastic

[difftool "difftastic"]
    # Keep diffs open until q, without making lazygit pause after editors.
    cmd = difft --color=always "$LOCAL" "$REMOTE" | less -R -+F

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    # `git push` sets upstream on the first push of a new branch
    autoSetupRemote = true

[rebase]
    autosquash = true

[rerere]
    # remember conflict resolutions and replay them on rebase/merge
    enabled = true

[alias]
    co = checkout
    cob = checkout -b
    coo = !git fetch && git checkout
    br = branch
    d = diff --
    dft = -c diff.external=difft diff
    merged = branch --merged
    prune-branches = "!git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"
    s = status
    aa = add -A .
    cm = commit -m
    aacm = !git add -A . && git commit -m
    dev = !git checkout dev && git pull origin dev
    m = !git checkout main && git pull
    p = push
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    lg = log --graph --oneline --decorate --all
    amend = commit --amend --no-edit

# Identity lives outside the repo; see .gitconfig.local.example
[include]
    path = ~/.gitconfig.local
