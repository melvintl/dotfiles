[core]
    editor = nvim
	excludesfile = ~/.gitignore
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    light = false
    line-numbers = true
    syntax-theme = OneHalfDark
    # OneDark-muted line backgrounds; keep in sync with .config/lazygit/config.yml
    plus-style = syntax "#2f3b2c"
    minus-style = syntax "#3f2d31"
    plus-emph-style = syntax "#405a35"
    minus-emph-style = syntax "#6a3a40"
    file-style = "#61afef"
    hunk-header-style = "#c678dd"

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    tool = difftastic

[difftool "difftastic"]
    # Keep diffs open until q, without making lazygit pause after editors.
    cmd = difft --color=always "$LOCAL" "$REMOTE" | less -R -+F

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    # `git push` sets upstream on the first push of a new branch
    autoSetupRemote = true

[rebase]
    autosquash = true

[rerere]
    # remember conflict resolutions and replay them on rebase/merge
    enabled = true

[alias]
    co = checkout
    cob = checkout -b
    coo = !git fetch && git checkout
    br = branch
    d = diff --
    dft = -c diff.external=difft diff
    merged = branch --merged
    prune-branches = "!git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"
    s = status
    aa = add -A .
    cm = commit -m
    aacm = !git add -A . && git commit -m
    dev = !git checkout dev && git pull origin dev
    m = !git checkout main && git pull
    p = push
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    lg = log --graph --oneline --decorate --all
    amend = commit --amend --no-edit

# Identity lives outside the repo; see .gitconfig.local.example
[include]
    path = ~/.gitconfig.local
